{
  "manifest_version": 3,
  "name": "LexiFlow",
  "version": "1.0.0",
  "description": "AI-powered language intelligence. Select. Translate. Learn.",
  "permissions": [
    "activeTab", "contextMenus", "storage",
    "scripting", "notifications", "sidePanel", "clipboardWrite"
  ],
  "host_permissions": ["http://localhost/*", "https://localhost/*"],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/index.html"
  },
  "side_panel": { "default_path": "sidebar/index.html" },
  "options_page": "options/index.html",
  "commands": {
    "translate-selection": {
      "suggested_key": { "default": "Alt+T", "linux": "Alt+T" },
      "description": "Translate selected text"
    }
  }
}
